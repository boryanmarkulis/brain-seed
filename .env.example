# Copy to .env and fill in what you actually use. .env is gitignored.
# Never commit real values. connections.md names these vars, never their values.

# --- Optional: the wiki compiler ---
# The compiler shells out to whichever CLI you already have logged in, so no
# API key is needed for the default path. Set this only to force one:
#   BRAIN_COMPILE_PROVIDER=claude      # use the `claude` CLI
#   BRAIN_COMPILE_PROVIDER=codex       # use the `codex` CLI
# BRAIN_COMPILE_PROVIDER=auto

# --- Optional: override any brain.config.json value for one run ---
# BRAIN_OWNER="Ada Lovelace"
# BRAIN_LOCAL_MODEL=qwen3-8b
# BRAIN_MEMORY_DIR=~/.brain-memory

# --- Your own integrations go below. Examples: ---
# NOTION_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
